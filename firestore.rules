rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidAvatar(avatarId) {
      return avatarId is string
        && avatarId in ['duck', 'owl', 'turtle', 'fox', 'cat', 'panda'];
    }

    function validProfileCreate() {
      return request.resource.data.keys().hasOnly([
          'email', 'avatarId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && (
          !('avatarId' in request.resource.data)
          || isValidAvatar(request.resource.data.avatarId)
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          !('email' in request.resource.data)
          || (
            request.resource.data.email is string
            && request.resource.data.email == request.auth.token.email
          )
        )
        && (
          !('createdAt' in request.resource.data)
          || (
            request.resource.data.createdAt is timestamp
            && request.resource.data.createdAt == request.time
          )
        );
    }

    function validProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.keys().hasOnly([
          'email', 'avatarId', 'createdAt', 'updatedAt'
        ])
        && changed.hasOnly(['avatarId', 'updatedAt'])
        && changed.hasAll(['updatedAt'])
        && (
          !('avatarId' in request.resource.data)
          || isValidAvatar(request.resource.data.avatarId)
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
          'completed_lesson_ids',
          'mistakes',
          'streak',
          'last_study_date',
          'exam_passed',
          'daily_goal',
          'daily_activity',
          'starting_level',
          'updated_at'
        ])
        && request.resource.data.keys().hasAll([
          'completed_lesson_ids',
          'mistakes',
          'streak',
          'last_study_date',
          'exam_passed',
          'daily_goal',
          'daily_activity',
          'updated_at'
        ])
        && request.resource.data.completed_lesson_ids is list
        && request.resource.data.mistakes is list
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && (
          request.resource.data.last_study_date == null
          || request.resource.data.last_study_date is string
        )
        && request.resource.data.exam_passed is bool
        && request.resource.data.daily_goal is int
        && request.resource.data.daily_goal in [1, 2, 3]
        && request.resource.data.daily_activity is map
        && request.resource.data.daily_activity.keys().hasOnly(['date', 'lessonIds'])
        && request.resource.data.daily_activity.keys().hasAll(['date', 'lessonIds'])
        && request.resource.data.daily_activity.date is string
        && request.resource.data.daily_activity.lessonIds is list
        && (
          !('starting_level' in request.resource.data)
          || request.resource.data.starting_level == null
          || (
            request.resource.data.starting_level is int
            && request.resource.data.starting_level in [1, 2, 3, 4]
          )
        )
        && request.resource.data.updated_at is timestamp
        && request.resource.data.updated_at == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && validProfileCreate();
      allow update: if isOwner(userId) && validProfileUpdate();
      allow delete: if false;

      match /progress/{progressId} {
        allow get: if isOwner(userId) && progressId == 'current';
        allow create, update: if isOwner(userId)
          && progressId == 'current'
          && validProgress();
        allow delete: if false;
      }
    }
    match /lessonReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['category','description','lessonId','lessonTitle','questionIndex','prompt','stimulus','reporterUid','source','status','createdAt'])
        && request.resource.data.category in ['incorrect_translation','arabic_text','pronunciation','incorrect_answer','technical_issue','other']
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.lessonId is int
        && request.resource.data.lessonTitle is string && request.resource.data.lessonTitle.size() <= 120
        && request.resource.data.questionIndex is int
        && request.resource.data.prompt is string && request.resource.data.prompt.size() <= 500
        && request.resource.data.stimulus is string && request.resource.data.stimulus.size() <= 500
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.source == 'lesson'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

  }
}
